# 복사해서 .env 로 저장하고 값을 채우세요.  (.env 는 커밋/공유 금지)

# OCR 백엔드 선택: google | stub
OCR_BACKEND=google

# Google Cloud Vision API 키
#  console.cloud.google.com -> 프로젝트 생성 -> "Cloud Vision API" 사용 설정
#  -> API 및 서비스 -> 사용자 인증 정보 -> API 키 만들기
#  -> (권장) 키 제한: Cloud Vision API 만 허용
GOOGLE_VISION_API_KEY=

# Firestore 동기화 (sync_pipeline.py). PC 가 꺼져 있어도 폰 PWA 가 조회할 수 있도록
# OCR 결과를 클라우드에 올린다.
#  firebase.google.com/ -> 프로젝트 생성(기존 GCP 프로젝트 재사용 가능) -> Firestore 사용 설정
#  -> 프로젝트 설정 -> 서비스 계정 -> "새 비공개 키 생성" 으로 JSON 다운로드
#  주의: 이 폴더는 Google Drive 동기화 폴더라 .gitignore 로도 Drive 업로드는 막지 못한다.
#  키 파일은 반드시 Drive 밖(예: %LOCALAPPDATA%\mom_study\firebase-service-account.json)에 둘 것.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=
