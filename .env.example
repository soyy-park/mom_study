# 복사해서 .env 로 저장하고 값을 채우세요.  (.env 는 커밋/공유 금지)
#
# ─────────────────────────────────────────────────────────────────────
# 새 컴퓨터에서 처음 받을 때 (코드는 GitHub, 비밀 값은 아래 방법으로 다시 받음)
#   git clone https://github.com/soyy-park/mom_study.git
#   cd mom_study
#   copy .env.example .env        (PowerShell: Copy-Item .env.example .env)
#   → 아래 각 항목의 "다시 받는 법" 대로 값을 채운다.
#   ※ .env, 서비스 계정 JSON, data/ 는 git 에 없다. 잃어버리면 아래 방법으로 재발급.
# ─────────────────────────────────────────────────────────────────────

# OCR 백엔드 선택: google | stub   (stub 은 키 없이 테스트용)
OCR_BACKEND=google

# Google Cloud Vision API 키
#  [처음 만들 때]
#  console.cloud.google.com -> 프로젝트 생성 -> "Cloud Vision API" 사용 설정
#  -> API 및 서비스 -> 사용자 인증 정보 -> API 키 만들기
#  -> (권장) 키 제한: Cloud Vision API 만 허용
#  [이미 있는 키 다시 받는 법]
#  console.cloud.google.com -> 상단에서 프로젝트 "jini-study" 선택
#  -> API 및 서비스 -> 사용자 인증 정보 -> API 키 목록에서 해당 키 -> "키 표시" 로 복사
#  또는 Cloud Functions 에 저장해 둔 값을 꺼내기 (firebase CLI 로그인 필요):
#    firebase functions:secrets:access GOOGLE_VISION_API_KEY
GOOGLE_VISION_API_KEY=

# Firestore 동기화 (sync_pipeline.py). PC 가 꺼져 있어도 폰 PWA 가 조회할 수 있도록
# OCR 결과를 클라우드에 올린다.
#
# FIREBASE_PROJECT_ID
#  [다시 받는 법] 저장소의 .firebaserc 의 "default" 값 그대로 (현재: jini-study)
#  또는 console.firebase.google.com -> 프로젝트 설정 -> 일반 -> "프로젝트 ID"
#
# FIREBASE_SERVICE_ACCOUNT_PATH  (서비스 계정 키 JSON 파일의 절대경로)
#  [처음 만들 때 / 잃어버렸을 때 재발급 — 기존 JSON 은 다시 다운로드 불가, 새로 만들어야 함]
#  console.firebase.google.com -> 프로젝트 "jini-study" -> 프로젝트 설정(톱니바퀴)
#  -> 서비스 계정 -> "새 비공개 키 생성" -> JSON 다운로드
#  -> 저장 위치 예: %LOCALAPPDATA%\mom_study\firebase-service-account.json
#     (Google Drive 등 동기화 폴더나 저장소 폴더 안에 두지 말 것)
#  -> 그 경로를 아래에 적는다.
#  (재발급했다면 GCP 콘솔 -> IAM 및 관리자 -> 서비스 계정 -> 키 탭에서 안 쓰는 옛 키는 삭제)
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=
