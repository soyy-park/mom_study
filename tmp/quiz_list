        searchBox.classList.toggle('hidden');
        if (!searchBox.classList.contains('hidden')) {
          const input = searchBox.querySelector('input');
          if (input) input.focus();
        }
      });
    }

    // Filter Chips Interactive State
    const filterChips = document.querySelectorAll('.filter-chip');
    filterChips.forEach(chip => {
      chip.addEventListener('click', () => {
        filterChips.forEach(c => {
          c.classList.remove('bg-secondary', 'text-on-secondary', 'shadow-sm');
          c.classList.add('bg-surface-container-highest/70', 'text-on-surface');
        });
        chip.classList.add('bg-secondary', 'text-on-secondary', 'shadow-sm');
        chip.classList.remove('bg-surface-container-highest/70', 'text-on-surface');
      });
    });

    // Detail Modal Control for Adult Learners
    const drawer = document.getElementById('problem-drawer');
