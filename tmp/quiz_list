      }
    };

    function openDetailModal(id) {
      if (!drawer) return;
      const data = problemData[id] || problemData[1];
      document.getElementById('drawer-title').textContent = data.title;
      document.getElementById('drawer-meta').textContent = data.meta;
      document.getElementById('drawer-subject').textContent = data.subject;
      drawer.classList.remove('hidden');
      drawer.classList.add('flex');
    }

    function closeDetailModal() {
      if (!drawer) return;
      drawer.classList.add('hidden');
      drawer.classList.remove('flex');
    }

