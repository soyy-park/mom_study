      numBadge.className = 'choice-num w-8 h-8 rounded-full bg-surface-container-high text-secondary flex items-center justify-center font-label-md text-label-md font-bold shrink-0';
      const icon = card.querySelector('.choice-indicator');
      icon.className = 'choice-indicator material-symbols-outlined text-outline-variant text-[24px] shrink-0';
      icon.innerText = 'radio_button_unchecked';
      icon.style.fontVariationSettings = "'FILL' 0";
    });

    el.className = 'choice-card group w-full min-h-[58px] p-4 rounded-xl text-left transition-all duration-150 flex items-start sm:items-center justify-between gap-3 bg-primary-fixed/40 text-on-surface shadow-md';
    const activeBadge = el.querySelector('.choice-num');
    activeBadge.className = 'choice-num w-8 h-8 rounded-full bg-primary text-on-primary flex items-center justify-center font-label-md text-label-md font-bold shrink-0 shadow-sm';
    const activeIcon = el.querySelector('.choice-indicator');
    activeIcon.className = 'choice-indicator material-symbols-outlined text-primary text-[26px] shrink-0';
    activeIcon.innerText = 'check_circle';
    activeIcon.style.fontVariationSettings = "'FILL' 1";
  }

  function toggleExplanation() {
    const expBox = document.getElementById('explanation-box');
    expBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    const checkBtn = document.getElementById('check-btn');
    checkBtn.classList.add('bg-primary');
    checkBtn.innerHTML = '<span class="material-symbols-outlined text-[24px]">done_all</span><span>정답 확인 완료</span>';
  }

  function nextQuestion() {
    alert('다음 5번 문제로 이동합니다. 힘내세요!');
