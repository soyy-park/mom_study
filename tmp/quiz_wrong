<script>
  function selectOption(el) {
    const container = document.getElementById('choice-container');
    const cards = container.querySelectorAll('.choice-card');
    
    cards.forEach(card => {
      card.className = 'choice-card group w-full min-h-[58px] p-4 rounded-xl text-left transition-all duration-150 flex items-start sm:items-center justify-between gap-3 bg-surface-container-low hover:bg-surface-container text-on-surface shadow-sm';
